# Copia este archivo a .env y rellena los valores. El .env real no se versiona.

# Secreto de firma de los JWT. Minimo 32 bytes. Si se deja vacio, el backend genera
# una clave aleatoria temporal en cada arranque (los tokens no sobreviven a un reinicio).
# Genera uno seguro, por ejemplo: openssl rand -base64 48
JWT_SECRET=

# Validez del token en milisegundos (por defecto 24 h).
JWT_EXPIRATION=86400000

# Contrasena de root de MySQL para docker-compose.
MYSQL_ROOT_PASSWORD=

# Activa el log de SQL de Hibernate (true/false).
SHOW_SQL=false
